NODE_ENV=staging
PORT=5000
CLIENT_URL=https://staging.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/consultation_platform_staging
JWT_SECRET=LOAD_FROM_SECRET_MANAGER
JWT_EXPIRES_IN=15m
COOKIE_SECURE=true
DEV_EXPOSE_AUTH_CODES=false
VERIFICATION_MODE=PRODUCTION
IDENTITY_VERIFICATION_URL=https://your-contracted-kyc-provider.example/verify
IDENTITY_VERIFICATION_API_KEY=LOAD_FROM_SECRET_MANAGER
HPCSA_VERIFICATION_URL=https://your-authorised-registry-integration.example/hpcsa/verify
HPCSA_VERIFICATION_API_KEY=LOAD_FROM_SECRET_MANAGER
LPC_VERIFICATION_URL=https://your-authorised-registry-integration.example/lpc/verify
LPC_VERIFICATION_API_KEY=LOAD_FROM_SECRET_MANAGER
QUALIFICATION_VERIFICATION_URL=https://your-authorised-qualification-provider.example/verify
QUALIFICATION_VERIFICATION_API_KEY=LOAD_FROM_SECRET_MANAGER
