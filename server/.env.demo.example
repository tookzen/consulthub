# ==========================================================
# ConsultHub - Demo / Development Server Environment
# ==========================================================

NODE_ENV=production


# ----------------------------------------------------------
# CLIENT / CORS
# ----------------------------------------------------------

CLIENT_URL=https://consulthub-demo.onrender.com


# ----------------------------------------------------------
# DATABASE
# ----------------------------------------------------------
# Use the INTERNAL PostgreSQL URL from Render.
# Do not use this sample password/hostname.

DATABASE_URL=postgresql://consultation_platform_user:4CiPQCSa3AMpcH8VKE3fHGhzusM8ArNj@dpg-daqnc67f3r2c73bfeb0g-a/consultation_platform


# ----------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------

# Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=3f9c182c6aacfa761b775b4502965d1f685ae54e814ab9472527be72893df8532d776d4d440f91a634d42aace469a156ed626e0e748e49c1bc16d082b0009df6

# Short-lived access token
JWT_EXPIRES_IN=15m

# HTTPS cookies on Render
COOKIE_SECURE=true


# ----------------------------------------------------------
# DEMO AUTHENTICATION
# ----------------------------------------------------------
# Allows verification/MFA codes to be shown in the UI.
#
# DEMO ONLY.
# Set to false before a public production launch.

DEV_EXPOSE_AUTH_CODES=true


# Password used by seeded demo users.
# Use something stronger than Password123! once online.

DEMO_PASSWORD=Password123!


# ----------------------------------------------------------
# PROFESSIONAL VERIFICATION
# ----------------------------------------------------------
# Uses our fake HPCSA/LPC/KYC adapters.

VERIFICATION_MODE=MOCK


# ----------------------------------------------------------
# FILE / DOCUMENT STORAGE
# ----------------------------------------------------------
# Render persistent disk should be mounted at /var/data

STORAGE_ROOT=/var/data/consulthub


# ----------------------------------------------------------
# CONSULTATION ROOM
# ----------------------------------------------------------

# Optional room timing settings if supported by your current build.

CONSULTATION_ROOM_OPEN_BEFORE_MINUTES=15
CONSULTATION_ROOM_CLOSE_AFTER_MINUTES=60


# ----------------------------------------------------------
# PRODUCTION VERIFICATION PROVIDERS
# ----------------------------------------------------------
# Leave blank while VERIFICATION_MODE=MOCK.

IDENTITY_VERIFICATION_URL=
IDENTITY_VERIFICATION_API_KEY=

HPCSA_VERIFICATION_URL=
HPCSA_VERIFICATION_API_KEY=

LPC_VERIFICATION_URL=
LPC_VERIFICATION_API_KEY=

QUALIFICATION_VERIFICATION_URL=
QUALIFICATION_VERIFICATION_API_KEY=
