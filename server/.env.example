NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/consultation_platform
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=20m
COOKIE_SECURE=false
