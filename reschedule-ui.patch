+.reschedule-overlay{position:fixed;inset:0;z-index:1000;background:rgba(16,34,43,.58);backdrop-filter:blur(4px);display:grid;place-items:center;padding:22px;animation:rescheduleFade .16s ease-out}.reschedule-dialog{width:min(760px,100%);max-height:calc(100vh - 44px);overflow:auto;background:#fff;border-radius:20px;box-shadow:0 28px 80px rgba(5,28,39,.28);border:1px solid rgba(255,255,255,.7);animation:rescheduleLift .18s ease-out}.reschedule-header{display:flex;justify-content:space-between;gap:22px;padding:24px 26px 18px;border-bottom:1px solid #e8edef}.reschedule-header h3{margin:2px 0 5px;font-size:25px;color:#183542}.reschedule-header p{margin:0;color:#6c7d86;font-size:14px}.reschedule-eyebrow{font-size:10px;letter-spacing:.12em;font-weight:900;color:#0f766e}.reschedule-close{flex:0 0 auto;width:36px;height:36px;border-radius:50%;border:1px solid #dbe3e6;background:#fff;color:#60727c;font-size:25px;line-height:1;cursor:pointer}.reschedule-close:hover{background:#f4f7f8}.reschedule-current{margin:18px 26px 0;padding:15px 17px;border:1px solid #dfe8ea;border-radius:13px;background:#f7fafb;display:flex;justify-content:space-between;gap:18px;align-items:center}.reschedule-current>div:first-child{display:flex;flex-direction:column;gap:3px}.reschedule-current span{color:#71828c;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em}.reschedule-current b{font-size:15px;color:#203b48}.reschedule-current small{color:#71828c}.reschedule-state{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.reschedule-pill{font-size:10px!important;padding:6px 9px;border-radius:999px;background:#edf2f3;color:#5d6e77!important}.reschedule-pill.confirmed,.reschedule-pill.paid{background:#e4f6ef;color:#0d6d5f!important}.reschedule-pill.pending{background:#fff2d7;color:#8a631d!important}.reschedule-body{padding:10px 26px 4px}.reschedule-step{display:grid;grid-template-columns:34px 1fr;gap:13px;padding:18px 0;border-bottom:1px solid #edf1f2}.reschedule-step-n